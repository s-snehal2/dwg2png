# ============================================================
# DWG → PNG Converter — environment configuration
#
# Next.js automatically loads a `.env` file from this directory.
# To use: copy this file to `.env` and edit the values you want
# to change. Leave most lines at their defaults.
# ============================================================

# Directory for staged uploads and outputs. Relative to this folder
# (frontend/), so temp files land in ./temp by default.
TEMP_DIR=./temp

# Maximum DWG upload size, in megabytes.
MAX_FILE_SIZE_MB=50

# Maximum paper-space layouts accepted before the DWG is rejected as
# "multi-sheet". Keep at 1 for a single-PNG-per-upload flow.
MAX_LAYOUTS=1

# Maximum output PNG width/height, in pixels.
MAX_PNG_DIMENSION=3000

# Oversample factor for anti-aliased output (2 = render at 2x, downscale to fit).
PNG_SUPERSAMPLE=2

# Minimum stroke thickness in pixels, so thin CAD lines stay visible.
MIN_STROKE_PX=1

# Padding (margin) around the drawing, in pixels.
MARGIN_PX=50

# Age (in minutes) after which temporary files are swept.
CLEANUP_AGE_MINUTES=1440

# Per-IP convert requests allowed per minute.
RATE_LIMIT_PER_MINUTE=30

# ------------------------------------------------------------------
# AI image generation (Gemini 3.1 Flash / Nano Banana 2)
#
# Set GEMINI_API_KEY to enable the "Generate AI image" button.
# Leave it empty to keep the feature disabled.
# ------------------------------------------------------------------
# GEMINI_API_KEY=

# Model used for AI image generation.
GEMINI_MODEL=gemini-3.1-flash-image

# Maximum time (in milliseconds) Gemini may take to produce an image.
# Default 240000 (240s), leaving room under Vercel's 300s function limit.
# GEMINI_TIMEOUT_MS=240000

# OPTIONAL: override the built-in prompt sent to Gemini.
# Leave empty to use the built-in architectural-visualization prompt.
# GEMINI_PROMPT=


# ------------------------------------------------------------------
# Rendering options
# ------------------------------------------------------------------
# Set to "color" for colored (layer-based) output; default is monochrome.
# COLOR_MODE=color

# ------------------------------------------------------------------
# TilesView room-planner upload (optional)
# Set TILESVIEW_APP_KEY + TILESVIEW_APP_SECRET to enable the
# "View in Visualizer" button after AI image generation.
# ------------------------------------------------------------------
TILESVIEW_API_URL=https://tilesview.ai/Provider/app/api-room-planner-data
# TILESVIEW_APP_KEY=
# TILESVIEW_APP_SECRET=

# TilesView auth header names (only change if the provider renames them).
# TILESVIEW_APP_KEY_HEADER=app_key
# TILESVIEW_APP_SECRET_HEADER=app_secret
